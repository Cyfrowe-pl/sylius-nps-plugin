{% extends layout %}

{% block subject %}
    {{ subject_key|trans({'%score%': survey.score, '%number%': survey.orderNumber}, null, localeCode) }}
{% endblock %}

{% block content %}
    {#
        Red for an alert that asks for action, Sylius's own teal for a correction that takes one back.
        Tables and inline styles throughout, so the layout holds in Outlook, which renders through Word.
    #}
    {% set accent = kind|default(null) == 'correction' ? '#1abb9c' : '#db2828' %}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td width="56" valign="top" style="width: 56px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                        <td width="56" height="56" align="center" valign="middle" bgcolor="{{ accent }}" style="width: 56px; height: 56px; background: {{ accent }}; mso-line-height-rule: exactly; line-height: 56px; color: #fff; font-size: 24px; font-weight: bold; text-align: center;">{{ survey.score }}</td>
                    </tr>
                </table>
            </td>
            <td width="16" style="width: 16px; font-size: 0; line-height: 0;">&nbsp;</td>
            <td valign="middle" style="text-align: left;">
                <p style="margin: 0 0 6px; font-size: 18px; line-height: 1.3; font-weight: bold;">
                    {{ lead_key|trans({'%score%': survey.score, '%number%': survey.orderNumber}, null, localeCode) }}
                </p>

                {# Whether the score can still move decides whether the operator acts now or waits. #}
                <p style="margin: 0; font-size: 13px; line-height: 1.4; color: #777;">
                    {% if final %}
                        {{ 'cyfrowe_nps.email.critical.final'|trans([], null, localeCode) }}
                    {% else %}
                        {{ 'cyfrowe_nps.email.critical.provisional'|trans({
                            '%date%': survey.expiresAt ? survey.expiresAt|date('d.m.Y') : '-',
                        }, null, localeCode) }}
                    {% endif %}
                </p>
            </td>
        </tr>
    </table>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
        <tr>
            <td bgcolor="#f5f5f5" style="padding: 14px 16px; background: #f5f5f5; border-left: 3px solid {{ accent }}; text-align: left;">
                <p style="margin: 0 0 8px; font-weight: bold;">{{ 'cyfrowe_nps.email.critical.comment'|trans([], null, localeCode) }}</p>
                {% if survey.comment is not empty %}
                    <p style="margin: 0;">{{ survey.comment|nl2br }}</p>
                {% else %}
                    <p style="margin: 0; color: #777; font-style: italic;">{{ 'cyfrowe_nps.email.critical.no_comment'|trans([], null, localeCode) }}</p>
                {% endif %}
            </td>
        </tr>
    </table>

    {% set label_style = 'width: 45%; padding: 8px 12px 8px 0; border-bottom: 1px solid #eee; color: #777; text-align: left; vertical-align: top;' %}
    {% set value_style = 'padding: 8px 0; border-bottom: 1px solid #eee; text-align: left; vertical-align: top;' %}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
        <tr>
            <td width="45%" style="{{ label_style }}">{{ 'cyfrowe_nps.email.critical.order'|trans([], null, localeCode) }}</td>
            <td style="{{ value_style }} font-weight: bold;">{{ survey.orderNumber ?? '-' }}</td>
        </tr>
        {% if survey.orderTotal is not null %}
            <tr>
                <td width="45%" style="{{ label_style }}">{{ 'cyfrowe_nps.email.critical.order_value'|trans([], null, localeCode) }}</td>
                <td style="{{ value_style }}">{{ survey.orderTotal|sylius_format_money(survey.currencyCode, localeCode) }}</td>
            </tr>
        {% endif %}
        <tr>
            <td width="45%" style="{{ label_style }}">{{ 'cyfrowe_nps.email.critical.shipping_method'|trans([], null, localeCode) }}</td>
            <td style="{{ value_style }}">{{ survey.shippingMethodName ?? '-' }}</td>
        </tr>
    </table>

    {#
        The channel is looked up by the code stored on the record, and nothing stops a shop from
        removing a channel that answers still refer to. Handed a null channel, sylius_channel_url
        asks the channel context instead - which, in the command this email is sent from, has no
        request to answer from and throws. The router's own absolute url is the fallback.
        The button is the one Sylius's own emails use.
    #}
    <div style="margin-top: 36px; text-align: center;">
        <a href="{{ channel ? sylius_channel_url(path('cyfrowe_nps_admin_survey_show', card_route), channel) : url('cyfrowe_nps_admin_survey_show', card_route) }}"
           style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; border-radius: 3px;">
            {{ 'cyfrowe_nps.email.critical.open_card'|trans([], null, localeCode) }}
        </a>
    </div>

    {% if survey.botSuspected %}
        {# Said out loud rather than acted on: the flag never decides whether the alert goes out. #}
        <p style="margin: 24px 0 0; font-size: 12px; color: #777; text-align: center;">{{ 'cyfrowe_nps.email.critical.bot_suspected'|trans([], null, localeCode) }}</p>
    {% endif %}
{% endblock %}
