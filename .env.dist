# Copy to .env, or let `make .env` generate it with your own ids.
# UID/GID decide who owns the files the container writes into the bind mount.
UID=1000
GID=1000

# PHP version inside the container. The package supports 8.2 and up; 8.2 is the
# default because it is the lowest supported version.
PHP_VERSION=8.2

# Host ports. Kept off 80 and 3306 so they do not clash with a web server or a
# database already running on the host.
HTTP_PORT=8080
MYSQL_PORT=3307
