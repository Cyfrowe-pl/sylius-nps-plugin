{
    "name": "cyfrowe/sylius-nps-plugin",
    "type": "sylius-plugin",
    "description": "NPS survey plugin for Sylius: sends a survey after shipping or delivery, collects scores and comments, reports the score in the admin panel.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "nps"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "~1.14.0",
        "symfony/framework-bundle": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/rate-limiter": "^6.4",
        "symfony/security-bundle": "^6.4"
    },
    "require-dev": {
        "behat/behat": "^3.6.1",
        "friends-of-behat/mink": "^1.8",
        "friends-of-behat/mink-browserkit-driver": "^1.4",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.1",
        "friends-of-behat/variadic-extension": "^1.3",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^1.8.1",
        "phpstan/phpstan-doctrine": "1.3.69",
        "phpstan/phpstan-strict-rules": "^1.3.0",
        "phpstan/phpstan-webmozart-assert": "^1.2.0",
        "phpunit/phpunit": "^10.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "sylius-labs/coding-standard": "^4.2",
        "sylius-labs/suite-tags-extension": "^0.2",
        "symfony/browser-kit": "^5.4 || ^6.4",
        "symfony/debug-bundle": "^5.4 || ^6.4",
        "symfony/dotenv": "^5.4 || ^6.4",
        "symfony/flex": "^2.4",
        "symfony/intl": "^5.4 || ^6.4",
        "symfony/web-profiler-bundle": "^5.4 || ^6.4"
    },
    "conflict": {
        "symfony/framework-bundle": "6.2.8"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true
        },
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-8kfs-m8zw-ggzs",
                    "PKSA-3ncz-km6v-5vjr",
                    "PKSA-gs8r-6kz6-pp56",
                    "PKSA-gnn4-pxdg-q76m"
                ]
            }
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4"
        }
    },
    "autoload": {
        "psr-4": {
            "Cyfrowe\\SyliusNpsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Cyfrowe\\SyliusNpsPlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
